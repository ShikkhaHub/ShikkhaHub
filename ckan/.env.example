# ShikkhaHub CKAN configuration
# Copy to .env to customize (docker compose -f ckan/docker-compose.yml)

# --- CKAN core ---
CKAN_SITE_URL=http://localhost:5000
CKAN_SITE_ID=shikkhahub
CKAN_VERSION=2.10.5

# --- Database ---
CKAN_DB_USER=ckan_default
CKAN_DB_PASSWORD=ckan_default
CKAN_DB_DATABASE=ckan_default
CKAN_DATASTORE_RO_PASSWORD=ckan_datastore_ro
CKAN_DATASTORE_WRITE_PASSWORD=ckan_datastore_write

# --- Admin bootstrap ---
CKAN_SYSADMIN_NAME=ckan_admin
CKAN_SYSADMIN_EMAIL=admin@shikkhahub.com
CKAN_SYSADMIN_PASSWORD=changeme123

# --- API token used by internal ShikkhaHub services ---
CKAN_API_TOKEN=changeme_ckan_api_token

# --- Uploads ---
CKAN_MAX_UPLOAD_SIZE_MB=10

# --- Email (production) ---
SMTP_SERVER=
SMTP_USER=
SMTP_PASSWORD=
SMTP_MAIL_FROM=ckan@shikkhahub.com

# ShikkhaHub Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=shikkhahub
DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/shikkhahub

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================================
# Elasticsearch Configuration
# =============================================================================
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elastic_password_here

# =============================================================================
# Security Configuration
# =============================================================================
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# OpenAI / AI Configuration
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# =============================================================================
# Application Configuration
# =============================================================================
ENVIRONMENT=development
DEBUG=true
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# =============================================================================
# Docker Registry
# =============================================================================
DOCKER_REGISTRY=your-dockerhub-username
TAG=latest

# =============================================================================
# External Services (Production)
# =============================================================================
# Cloudflare / CDN
CLOUDFLARE_API_TOKEN=your_cloudflare_token

# Email (SendGrid/SES)
SENDGRID_API_KEY=your_sendgrid_key
EMAIL_FROM=noreply@shikkhahub.com

# Monitoring (Sentry)
SENTRY_DSN=your_sentry_dsn

# Analytics (Google Analytics)
GA_TRACKING_ID=your_ga_id

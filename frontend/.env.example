# Base URL of the deployed ShikkhaHub backend (FastAPI on Vercel).
# Must end with /api/v1. Set the same value in the Vercel frontend project
# under Environment Variables (name: VITE_API_URL) for production builds.
#
# During local development the Vite proxy (vite.config.ts) forwards /api to
# http://localhost:8000, so this can be left empty locally.
VITE_API_URL=https://shikkhahub-backend.vercel.app/api/v1
